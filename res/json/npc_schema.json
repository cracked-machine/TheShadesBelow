{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPC objects",
  "type": "object",
  "patternProperties": {
    "^npc\\..+$": {
      "type": "object",
      "required": ["sprites", "actions", "lerpspeed", "framerate"],
      "additionalProperties": false,
      "properties": {
        "sprites": {
          "type": "array",
          "description": "The list of sprite identifiers for the item",
          "minItems": 1
        },
        "lerpspeed": {
          "type": "number",
          "description": "Lerp completion speed"
        },
        "framerate": {
          "type": "number",
          "description": "Animation framerate"
        },
        "actions": {
          "type": "array",
          "description": "List of actions available for this item",
          "minItems": 8,
          "maxItems": 8,
          "allOf": [
            { "contains": { "required": ["burn_action"] } },
            { "contains": { "required": ["carry_action"] } },
            { "contains": { "required": ["consume_action"] } },
            { "contains": { "required": ["destroy_action"] } },
            { "contains": { "required": ["spawn_action"] } },
            { "contains": { "required": ["proximity_action"] } },
            { "contains": { "required": ["sacrifice_action"] } },
            { "contains": { "required": ["projectile_action"] } },
            { "contains": { "required": ["collision_action"] } }
          ],
          "items": {
            "type": "object",
            "maxProperties": 1,
            "properties": {
              "burn_action": {
                "description": "Applied repeatedly, at its own tick interval, while the item is burning.",
                "allOf": [{ "$ref": "#/definitions/burn_effect" }]
              },
              "carry_action": {
                "description": "Defined for schema uniformity with items.json; not currently applied to NPCs.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "consume_action": {
                "description": "Defined for schema uniformity with items.json; not currently applied to NPCs.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "destroy_action": {
                "description": "Applied to the player when this NPC is destroyed/removed, before the destroyed entity's components are removed. See NpcFactory.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "spawn_action": {
                "description": "Applied to the player when this NPC spawns. See NpcFactory/GraveSystem.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "proximity_action": {
                "description": "Applied repeatedly, at its own tick interval, while the player is near the NPC and it is within the current screen view.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "sacrifice_action": {
                "description": "Defined for schema uniformity with items.json; not currently applied to NPCs.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "projectile_action": {
                "description": "Applied to the player when hit by this NPC's ranged projectile (e.g. a priest's projectile or a watchman's gunfire). See ShockwaveSystem.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "collision_action": {
                "description": "Applied to the player when they physically collide with this NPC. See NpcSystem.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "action_effect": {
      "type": "object",
      "required": ["health", "fear", "despair", "infamy", "toxicity", "toxidrome", "luck", "tick"],
      "additionalProperties": false,
      "properties": {
        "health":   { "type": "number" },
        "fear":     { "type": "number" },
        "despair":  { "type": "number" },
        "infamy":   { "type": "number" },
        "toxicity": { "type": "number" },
        "luck":     { "type": "number" },
        "toxidrome": {
          "type": "object",
          "required": ["type", "tick"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
               "enum": ["none", "tachycardia", "bradycardia", "halucinogen", "hypoxia", "phototoxia"]
            },
            "tick": { "type": "number" }
          }
        },
        "tick": {
          "description": "Zero for instant dmg using knockback with cooldown, Non-zero for damage every tick.",
          "type": "number"
        }
      }
    }
  }
}