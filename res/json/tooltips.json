{
  "enabled": true,
  "panel": {
    "font_size": 30,
    "padding": 20,
    "fill_colour": { "r": 170, "g": 170, "b": 127, "a": 255 },
    "line_colour": { "r": 85, "g": 85, "b": 0, "a": 255 },
    "text_colour": { "r": 0, "g": 0, "b": 0, "a": 255 }
  },
  "tooltips": [
    {
      "id": "first_shovel",
      "trigger": "ItemPickedUpEvent",
      "condition": { "item": "item.shovel" },
      "text": "You carry a shovel. Use it to dig obstacles and graves, uproot plants and fight.",
      "position": "above_player",
      "frequency": "once",
      "duration_s": 6.0,
      "pause": true
    },
    {
      "id": "first_witchesbroom",
      "trigger": "ItemPickedUpEvent",
      "condition": { "item": "item.witchesbroom" },
      "text": "A witch's broom! Use it to fly.\nDon't drop it mid-flight.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "grimoire_updated",
      "trigger": "GrimoireDiscoveryEvent",
      "text": "Grimoire updated: {item}\nPress <G> to open the grimoire.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "altar_approach",
      "trigger": "AltarApproachedEvent",
      "text": "Offer me your blood.\nPress <E> to bleed for the altar.",
      "position": "above_source",
      "frequency": "always",
      "duration_s": 5.0
    },
    {
      "id": "first_blood_offering",
      "trigger": "AltarBloodOfferedEvent",
      "text": "The altar drank some of your health as blood.\nIf your health runs out, you die. Drink blood vials from graves to heal.",
      "position": "above_source",
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "first_blood_vial",
      "trigger": "ItemPickedUpEvent",
      "condition": { "item": "item.grave.blood*" },
      "text": "The blood of the dead. Drink it to restore your health,\nthen return to the altar.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "blood_full_health",
      "trigger": "ConsumeRefusedEvent",
      "condition": { "item": "item.grave.blood*" },
      "text": "You are already at full health.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "always",
      "duration_s": 3.0
    },
    {
      "id": "blood_trail_in_progress",
      "trigger": "BloodRefusedEvent",
      "text": "An altar has already been activated.\nFollow the crow to the key grave before activating another altar.",
      "position": "above_source",
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "crypt_all_cadavers",
      "trigger": "CryptEntryRefusedEvent",
      "text": "You have already collected every cadaver part.\nThis crypt holds nothing more for you.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "always",
      "duration_s": 4.0
    }
  ]
