{
  "enabled": true,
  "panel": {
    "font_size": 24,
    "padding": 12,
    "fill_colour": { "r": 0, "g": 0, "b": 0, "a": 180 },
    "line_colour": { "r": 200, "g": 200, "b": 200, "a": 255 },
    "text_colour": { "r": 255, "g": 255, "b": 255, "a": 255 }
  },
  "tooltips": [
    {
      "id": "first_pickaxe",
      "trigger": "AddInventoryEvent",
