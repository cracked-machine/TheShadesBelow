{
  "enabled": true,
  "panel": {
    "position": { "x": 0.5, "y": 0.85 },
    "font_size": 24,
    "padding": 12,
    "fill_colour": { "r": 0, "g": 0, "b": 0, "a": 180 },
    "line_colour": { "r": 200, "g": 200, "b": 200, "a": 255 },
    "text_colour": { "r": 255, "g": 255, "b": 255, "a": 255 }
  },
  "tooltips": [
    {
      "id": "first_pickaxe",
      "trigger": "AddInventoryEvent",
      "condition": { "item": "item.pickaxe" },
      "text": "You carry a pickaxe. Use it to dig through obstacles.\nPress <Enter> to dismiss.",
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "first_witchesbroom",
      "trigger": "ItemPickedUpEvent",
      "condition": { "item": "item.witchesbroom" },
      "text": "A witch's broom! Use it to fly.\nDon't drop it mid-flight.",
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "grimoire_updated",
      "trigger": "GrimoireDiscoveryEvent",
      "text": "Grimoire updated: {item}\nPress <G> to open the grimoire.",
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "exitkey_no_anima",
      "trigger": "InsufficientAnimaEvent",
      "condition": { "item": "item.exitkey" },
      "text": "The exit key can only be offered when you have anima.\nOffer or eat plants to gain anima.",
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "talisman_no_anima",
      "trigger": "InsufficientAnimaEvent",
      "condition": { "item": "item.talisman*" },
      "text": "A talisman can only be activated when you have anima.\nOffer or eat plants to gain anima.",
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "talisman_trail_in_progress",
      "trigger": "TalismanRefusedEvent",
      "text": "An altar has already been activated.\nComplete its grave trail before activating another altar.",
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "crypt_all_cadavers",
      "trigger": "CryptEntryRefusedEvent",
      "text": "You have already collected every cadaver part.\nThis crypt holds nothing more for you.",
      "frequency": "always",
      "duration_s": 4.0
    }
  ]
}
