      "text": "You carry a pickaxe. Use it to dig through obstacles.\nPress <Enter> to dismiss.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "first_witchesbroom",
      "trigger": "ItemPickedUpEvent",
      "condition": { "item": "item.witchesbroom" },
      "text": "A witch's broom! Use it to fly.\nDon't drop it mid-flight.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "once",
      "duration_s": 6.0
    },
    {
      "id": "grimoire_updated",
      "trigger": "GrimoireDiscoveryEvent",
      "text": "Grimoire updated: {item}\nPress <G> to open the grimoire.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "exitkey_no_anima",
      "trigger": "InsufficientAnimaEvent",
      "condition": { "item": "item.exitkey" },
      "text": "The exit key can only be offered when you have anima.\nOffer or eat plants to gain anima.",
      "position": { "x": 0.5, "y": 0.85 },
      "frequency": "always",
      "duration_s": 4.0
    },
    {
      "id": "altar_approach",
