{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory Items",
  "type": "object",
  "patternProperties": {
    "^(item\\..+|ERROR_SPRITE)$": {
      "type": "object",
      "required": ["sprite", "wear", "sacrifice", "forage", "chop", "damage_to_weapon", "actions"],
      "additionalProperties": false,
      "properties": {
        "sprite": {
          "type": "string",
          "description": "The sprite identifier for the item"
        },
        "wear": {
          "type": "object",
          "required": ["location", "expiryseconds", "active_only"],
          "additionalProperties": false,
          "properties": {
            "location": {
              "type": "string",
              "enum": ["none", "world", "inventory", "both"],
              "description": "Where the item's wear level is active. World, Inventory or Both. None if the item does not wear."
            },
            "expiryseconds": {
              "type": "number",
              "description": "The expiry for this item in seconds. Zero if no expiry."
            },
            "active_only": {
              "type": "boolean",
              "description": "If true the item only wears while it is actively being used (e.g. flute playing, broom flying)."
            }
          }
        },
        "consumable": {
          "type": "string",
          "enum": ["none", "edible", "drinkable"],
          "description": "Can the item be eaten or drunk."
        },
        "sacrifice": {
          "type": "object",
          "required": ["enabled", "reward"],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether this item can be sacrificed at an altar. If true, exactly one of reward.item, reward.wealth or reward.special must be set. If false, none may be set."
            },
            "reward": {
              "type": "object",
              "required": ["item", "wealth", "special"],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "description": "The item that will spawn when this item is sacrificed. Must be a valid item key if populated, else empty string. Note, this will replace player inventory."
                },
                "wealth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The wealth gained when this item is sacrificed. Zero if unused. Tools (axe, pickaxe, shovel) can only be sacrificed once spent."
                },
                "special": {
                  "type": "string",
                  "enum": ["none", "altar", "banish", "crypt"],
                  "description": "A special altar effect. altar: light an altar candle (relics). banish: banish ghosts or gain an extra life at a crypt altar (witches jar). crypt: unlock the crypt key (exit key). none if unused."
                }
              }
            }
          }
        },
        "forage": {
          "type": "object",
          "required": ["reward"],
          "additionalProperties": false,
          "properties": {
            "reward": {
              "type": "object",
              "required": ["item"],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "description": "The item gained when this plant is foraged with an empty hand (added to inventory) or gloves (dropped next to the plant). Must be a valid item key if populated, else no op if empty string."
                }
              }
            }
          }
        },
        "chop": {
          "type": "object",
          "required": ["reward"],
          "additionalProperties": false,
          "properties": {
            "reward": {
              "type": "object",
              "required": ["item"],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "description": "The item dropped when this plant is chopped down with an axe. Must be a valid item key if populated, else no op if empty string."
                }
              }
            }
          }
        },
        "damage_to_weapon": {
          "type": "object",
          "description": "Wear damage this item inflicts on each weapon when the weapon is used against it.",
          "required": ["pickaxe", "axe", "shovel", "bow"],
          "additionalProperties": false,
          "properties": {
            "pickaxe": { "type": "integer" },
            "axe":     { "type": "integer" },
            "shovel":  { "type": "integer" },
            "bow":     { "type": "integer" }
          }
        },
        "actions": {
          "type": "array",
          "description": "List of actions available for this item",
          "minItems": 7,
          "maxItems": 7,
          "allOf": [
            { "contains": { "required": ["burn_action"] } },
            { "contains": { "required": ["carry_action"] } },
            { "contains": { "required": ["consume_action"] } },
            { "contains": { "required": ["destroy_action"] } },
            { "contains": { "required": ["spawn_action"] } },
            { "contains": { "required": ["proximity_action"] } },
            { "contains": { "required": ["sacrifice_action"] } }
          ],
          "items": {
            "type": "object",
            "maxProperties": 1,
            "properties": {
              "burn_action": {
                "description": "Applied repeatedly, at its own tick interval, while the item is burning.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "carry_action": {
                "description": "Applied repeatedly, at its own tick interval, while the item is held in the player's inventory (e.g. a carried candle accumulating darkness fear over time).",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "consume_action": {
                "description": "Applied when the item is consumed (eaten/drunk/used up).",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "destroy_action": {
                "description": "Applied when the item's world entity is destroyed/removed.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "spawn_action": {
                "description": "Applied when the item spawns (e.g. loot dropped by a destroyed grave or NPC).",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "proximity_action": {
                "description": "Applied repeatedly, at its own tick interval, while the player is near the item and it is within the current screen view.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "sacrifice_action": {
                "description": "Applied when the item is sacrificed at an altar.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "action_effect": {
      "type": "object",
      "required": ["health", "fear", "despair", "infamy", "toxidrome", "luck", "tick"],
      "additionalProperties": false,
      "properties": {
        "health":   { "type": "number" },
        "fear":     { "type": "number" },
        "despair":  { "type": "number" },
        "infamy":   { "type": "number" },
        "luck": { "type": "number" },
        "toxidrome":  {
          "type": "object",
          "required": ["type", "toxicity"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["none", "tachycardia", "bradycardia", "halucinogen", "hypoxia", "phototoxia", "venom", "vertigo", "all"]
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["tachycardia", "bradycardia", "halucinogen", "hypoxia", "phototoxia", "venom", "vertigo"]
                  }
                }
              ]
            },
            "toxicity": { "type": "number" }
          }
        },
        "tick": {
          "type": "number"
        }
      }
    }
  }
}