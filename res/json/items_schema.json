{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory Items",
  "type": "object",
  "patternProperties": {
    "^(item\\..+|ERROR_SPRITE)$": {
      "type": "object",
      "required": ["sprite", "expiry", "wear_location", "sacrifice_output", "is_sacrificial", "weapon_damage", "actions"],
      "additionalProperties": false,
      "properties": {
        "sprite": {
          "type": "string",
          "description": "The sprite identifier for the item"
        },
        "expiry": {
          "type": "number",
          "description": "The expiry for this item in seconds. Zero if no expiry."
        },
        "wear_location": {
          "type": "string",
          "enum": ["None", "World", "Inventory", "Both"],
          "description": "Where the item's wear level is active. World, Inventory or Both. None if the item does not wear."
        },
        "consumable": {
          "type": "string",
          "enum": ["none", "edible", "drinkable"],
          "description": "Can the item be eaten or drunk."
        },
        "sacrifice_output": {
          "type": "string",
          "description": "The item that will spawn when this item is sacrificed. Must a valid item key if populated, else no op if empty string. Note, this will replace player inventory."
        },
        "is_sacrificial": {
          "type": "boolean",
          "description": "Whether this item can be sacrificed at an altar."
        },
        "weapon_damage": {
          "type": "object",
          "description": "Wear damage this item inflicts on each weapon when the weapon is used against it.",
          "required": ["pickaxe", "axe", "shovel", "bow"],
          "additionalProperties": false,
          "properties": {
            "pickaxe": { "type": "integer" },
            "axe":     { "type": "integer" },
            "shovel":  { "type": "integer" },
            "bow":     { "type": "integer" }
          }
        },
        "actions": {
          "type": "array",
          "description": "List of actions available for this item",
          "minItems": 7,
          "maxItems": 7,
          "allOf": [
            { "contains": { "required": ["burn_action"] } },
            { "contains": { "required": ["carry_action"] } },
            { "contains": { "required": ["consume_action"] } },
            { "contains": { "required": ["destroy_action"] } },
            { "contains": { "required": ["spawn_action"] } },
            { "contains": { "required": ["proximity_action"] } },
            { "contains": { "required": ["sacrifice_action"] } }
          ],
          "items": {
            "type": "object",
            "maxProperties": 1,
            "properties": {
              "burn_action": {
                "description": "Applied repeatedly, at its own tick interval, while the item is burning.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "carry_action": {
                "description": "Applied repeatedly, at its own tick interval, while the item is held in the player's inventory (e.g. a carried candle accumulating darkness fear over time).",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "consume_action": {
                "description": "Applied when the item is consumed (eaten/drunk/used up).",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "destroy_action": {
                "description": "Applied when the item's world entity is destroyed/removed.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "spawn_action": {
                "description": "Applied when the item spawns (e.g. loot dropped by a destroyed grave or NPC).",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "proximity_action": {
                "description": "Applied repeatedly, at its own tick interval, while the player is near the item and it is within the current screen view.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              },
              "sacrifice_action": {
                "description": "Applied when the item is sacrificed at an altar.",
                "allOf": [{ "$ref": "#/definitions/action_effect" }]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "action_effect": {
      "type": "object",
      "required": ["health", "fear", "despair", "infamy", "toxidrome", "luck", "tick"],
      "additionalProperties": false,
      "properties": {
        "health":   { "type": "number" },
        "fear":     { "type": "number" },
        "despair":  { "type": "number" },
        "infamy":   { "type": "number" },
        "luck": { "type": "number" },
        "toxidrome":  {
          "type": "object",
          "required": ["type", "toxicity"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["none", "tachycardia", "bradycardia", "halucinogen", "hypoxia", "phototoxia", "venom", "vertigo", "all"]
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["tachycardia", "bradycardia", "halucinogen", "hypoxia", "phototoxia", "venom", "vertigo"]
                  }
                }
              ]
            },
            "toxicity": { "type": "number" }
          }
        },
        "tick": {
          "type": "number"
        }
      }
    }
  }
}